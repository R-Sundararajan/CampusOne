# Copy to .env for host development; never commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://campusone:campusone@127.0.0.1:5432/campusone
# Optional direct CLI/migration URL; leave unset locally. On Render with Neon,
# use the direct URL here and the pooled URL in DATABASE_URL (same database).
# DIRECT_URL=postgresql://<user>:<password>@<direct-neon-host>/<database>?sslmode=require
# Replace with a random secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
POSTGRES_USER=campusone
POSTGRES_PASSWORD=campusone
POSTGRES_DB=campusone
# Demonstration only: choose your own value before sharing the app.
DEMO_PASSWORD=
# Selected storage: PostgreSQL image bytes, including on Neon.
STORAGE_MODE=database
# Compose UI reminder threshold (0–100); rebuild the image after changes.
# Host Vite: use frontend/.env.local or export this variable in your shell.
VITE_ATTENDANCE_WARNING_THRESHOLD=75

# INSECURE academic demo: validates the exact domain, not mailbox ownership or identity.
# Admins must verify identity out of band before granting privileges or linking records.
INSTITUTIONAL_AUTH_MODE=domain-only-demo
# Optional legacy email-verification mode uses local previews or production SMTP.
# These mail settings are ignored in domain-only-demo mode.
MAIL_MODE=development
# SMTP requires TLS: port 465 is implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Trusted, one-time Admin bootstrap only. Remove these after use.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
